# Bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.
# .env dosyası git'e GÖNDERİLMEZ; .env.example ise şablon olarak gönderilir.

FLASK_APP=run.py
FLASK_ENV=development

# Uzun ve rastgele bir değer olmalı. Üretmek için terminalde:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya-uzun-rastgele-bir-anahtar-yazin

# Boş bırakılırsa instance/app.db kullanılır.
# Canlıda (Render) PostgreSQL adresi yazılır: postgresql://kullanici:parola@sunucu/veritabani
DATABASE_URL=

# (Hafta 7) Canlı sunumdaki demo hesapların parolası. Boşsa demo verisi eklenmez.
DEMO_PASSWORD=

# --- Hafta 9: Harici API'ler ---
# 1 (varsayılan): sahte servisler (internet/anahtar gerekmez, ödeme TEST MODUNDA)
# 0: aşağıdaki adreslere gerçek istek atılır
USE_MOCK_APIS=1
PRICE_API_URL=
PRICE_API_KEY=
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=

# --- Hafta 10: Yapay zekâ (Anthropic Claude) ---
# Boş bırakılırsa yapay zekâ kapalı olur; kural tabanlı öneri gösterilir.
# Anahtar: https://console.anthropic.com -> API Keys. ASLA koda veya git'e yazmayın.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
